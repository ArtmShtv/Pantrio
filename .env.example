# Copy to .env and fill in real values. .env is gitignored; this file is not,
# so never put real secrets here.

ENVIRONMENT=local

# Postgres. docker-compose.yml reads the same variables, so the container
# and the app can never disagree about credentials.
POSTGRES_USER=pantrio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pantrio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_ECHO=false

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
SESSION_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# OAuth providers: leave empty until you register an app with each provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
